# Supabase project credentials (Settings → API).
# These are inlined into the client bundle at build time and are safe to expose:
# Row-Level Security is the real access boundary. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
